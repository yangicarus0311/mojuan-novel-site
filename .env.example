# 数据库配置
# 使用 SQLite（本地开发，无需安装数据库）
DATABASE_URL=sqlite:///./novel.db
# 使用 MySQL（Docker 部署，修改后需注释 SQLite 配置）
# DATABASE_URL=mysql+pymysql://novel:novel123@localhost:3306/novel_web

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 服务配置
DEBUG=true

# Redis 配置（可选，用于缓存）
# REDIS_URL=redis://localhost:6379/0
